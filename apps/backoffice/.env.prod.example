# Copiar a .env.prod para correr ESTA app en local contra el Supabase de PRODUCCIÓN
# (`pnpm prod`). Los valores salen del Dashboard de Supabase del proyecto "Amena":
# Project Settings → API Keys.
#
# ⚠️ Con esto la app local escribe en la BASE DE DATOS REAL: usuarios, consumos,
#    cortes y correos son de verdad. Úsalo para verificar, no para experimentar.
VITE_SUPABASE_URL=https://newwfxojjhzmwbblocil.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_reemplazar_con_la_llave_de_prod

# Déjalo vacío también aquí: no queremos ruido de tu máquina en el Sentry de producción.
VITE_SENTRY_DSN=
