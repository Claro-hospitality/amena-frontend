# Supabase del sitio público amena.social (el mismo proyecto que usa el repo amena-landing).
# OJO: NO son las credenciales del Supabase de backoffice/portal (amena-backend) — es otro
# proyecto, con otro esquema. Copia este archivo a .env.local y pega las de amena.social.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# URL del sitio público (botón "Ver sitio" del menú lateral). Opcional.
VITE_SITIO_PUBLICO_URL=https://amena.social
