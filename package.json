{
  "name": "amena-front",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:backoffice": "turbo dev --filter=backoffice",
    "dev:portal": "turbo dev --filter=portal",
    "prod": "turbo dev:prod",
    "prod:backoffice": "turbo dev:prod --filter=backoffice",
    "prod:portal": "turbo dev:prod --filter=portal",
    "dev:lan": "./scripts/dev-lan.sh",
    "dev:lan:portal": "./scripts/dev-lan.sh portal",
    "dev:lan:backoffice": "./scripts/dev-lan.sh backoffice",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "gen:types": "supabase gen types typescript --local --schema public --schema eventos --workdir ../amena-backend > packages/supabase/src/database.types.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
